    lv2:symbol "gate5" ;
    rdfs:label "Gate 5" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 101 ;
    lv2:scalePoint [ rdfs:label "Global" ; rdf:value 0 ] , [ rdfs:label "5%" ; rdf:value 5 ] , [ rdfs:label "10%" ; rdf:value 10 ] , [ rdfs:label "15%" ; rdf:value 15 ] ,
                   [ rdfs:label "20%" ; rdf:value 20 ] , [ rdfs:label "25%" ; rdf:value 25 ] , [ rdfs:label "30%" ; rdf:value 30 ] , [ rdfs:label "35%" ; rdf:value 35 ] ,

<urn:generativearp:arp>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "Generative Arp" ;
    lv2:minorVersion 6 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map ;
    lv2:port
    [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , time:Position ;
        lv2:index 0 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ; lv2:symbol "midi_out" ; lv2:name "MIDI Out" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "rate" ; lv2:name "Rate" ;
        lv2:default 3 ; lv2:minimum 0 ; lv2:maximum 5 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1/4" ; rdf:value 0 ] , [ rdfs:label "1/8" ; rdf:value 1 ] ,
                       [ rdfs:label "1/8T" ; rdf:value 2 ] , [ rdfs:label "1/16" ; rdf:value 3 ] ,
                       [ rdfs:label "1/16T" ; rdf:value 4 ] , [ rdfs:label "1/32" ; rdf:value 5 ] ;
        lv2:displayPriority 40 ; pg:group <urn:generativearp:arp#g_arp> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "gate" ; lv2:name "Gate %" ;
        lv2:default 50 ; lv2:minimum 5 ; lv2:maximum 100 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 30 ; pg:group <urn:generativearp:arp#g_arp> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "order" ; lv2:name "Order" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 5 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Up" ; rdf:value 0 ] , [ rdfs:label "Down" ; rdf:value 1 ] ,
                       [ rdfs:label "Up-Down" ; rdf:value 2 ] , [ rdfs:label "Down-Up" ; rdf:value 3 ] ,
                       [ rdfs:label "As played" ; rdf:value 4 ] , [ rdfs:label "Random" ; rdf:value 5 ] ;
        lv2:displayPriority 20 ; pg:group <urn:generativearp:arp#g_arp> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "octaves" ; lv2:name "Octaves" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 4 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 10 ; pg:group <urn:generativearp:arp#g_arp> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "latch" ; lv2:name "Latch" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 40 ; pg:group <urn:generativearp:arp#g_pattern> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "length" ; lv2:name "Length" ;
        lv2:default 16 ; lv2:minimum 1 ; lv2:maximum 16 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 30 ; pg:group <urn:generativearp:arp#g_pattern> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "prob1" ; lv2:name "Prob %" ;
        lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:integer , pprops:notOnGUI ;
        lv2:displayPriority 40 ; pg:group <urn:generativearp:arp#g_step1> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
